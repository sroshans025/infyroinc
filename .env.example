# Optional. Copy to .env.local for local work, and add in Vercel -> Project -> Settings -> Environment Variables.

# Contact-form endpoint. Default: FormSubmit  https://formsubmit.co/ajax/info@infyroinc.com
# After activating the form, you can use FormSubmit's random alias to keep the email out of the code:
#   VITE_FORM_ENDPOINT=https://formsubmit.co/ajax/<alias>
VITE_FORM_ENDPOINT=

# Booking Google Forms (open in a new tab). Leave empty to scroll to the on-page enquiry form.
VITE_STUDIOS_GFORM_URL=
VITE_CONSTRUCTION_GFORM_URL=
